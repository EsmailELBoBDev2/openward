# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editors
.vscode/
.idea/
*.sublime-*

# Logs / runtime
*.log
npm-debug.log*
yarn-debug.log*

# Node (if you later add tooling)
node_modules/
package-lock.json

# Local Claude/AI agent state
.claude/
.aider*
.history/

# Local backups
*.bak
*.tmp
*.sqlite
*.db
backup-*.json

# LAN server runtime state (central DB + HMAC audit key — never commit)
server/data/

# Python (the dev server script is the only Py file, but ignore caches)
__pycache__/
*.pyc

# Environment / secrets (no secrets in this repo, but defensive)
.env
.env.local
*.pem
*.key
